# Tripifi CGR backend — copy to .env and fill in. Never commit real secrets.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://tripifi:tripifi@localhost:5432/tripifi
SECRET_KEY=change-me-in-every-environment
JWT_SECRET=change-me-in-every-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# AI provider: groq | nvidia | ollama (local, no key). Requested provider
# without a key falls back to any keyed provider, then local Ollama.
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=tripifi-demo-planner

# Hosted inference (keys stay server-side, never shipped to the browser)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_TIMEOUT=60

# Phase 7 AI core — Ollama-first (local, no key needed). Future providers optional.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000
AI_MAX_TOOL_CALLS=6
AI_STREAMING_ENABLED=true

FLIGHT_API_KEY=
HOTEL_API_KEY=
MAPS_API_KEY=
PAYMENT_API_KEY=
PAYMENT_PROVIDER=demo
PAYMENT_WEBHOOK_SECRET=

# Phase 5 — free-first providers (dev defaults; see README for licensing notes)
FLIGHT_PROVIDER=demo
TRAIN_PROVIDER=demo
HOTEL_PROVIDER=demo
CAB_PROVIDER=tripifi
ROUTING_PROVIDER=osrm
GEOCODING_PROVIDER=nominatim
AVIATION_API_KEY=
GRAPHHOPPER_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

EMAIL_PROVIDER=none
EMAIL_API_KEY=
ADMIN_EMAIL=

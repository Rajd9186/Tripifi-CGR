# Tripifi CGR backend — copy to .env and fill in. Never commit real secrets.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://tripifi:tripifi@localhost:5432/tripifi
SECRET_KEY=change-me-in-every-environment
JWT_SECRET=change-me-in-every-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# AI provider chain: ollama (cloud when OLLAMA_API_KEY is set, else local)
# then groq, then nvidia. Requested provider without a key is skipped.
AI_PROVIDER=ollama
AI_API_KEY=
AI_MODEL=tripifi-demo-planner

# Hosted inference (keys stay server-side, never shipped to the browser)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_TIMEOUT=60

# Phase 7 AI core — Ollama-first (local, no key needed). Future providers optional.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60
# Ollama Cloud (https://docs.ollama.com/cloud, no local install needed).
# Key from https://ollama.com/settings/keys — server-side only, never commit.
# List valid cloud model names: curl https://ollama.com/api/tags
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=gemma4:31b
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000
AI_MAX_TOOL_CALLS=6
AI_STREAMING_ENABLED=true

FLIGHT_API_KEY=
HOTEL_API_KEY=
MAPS_API_KEY=
PAYMENT_API_KEY=
PAYMENT_PROVIDER=demo
PAYMENT_WEBHOOK_SECRET=

# Phase 5 — free-first providers (dev defaults; see README for licensing notes)
FLIGHT_PROVIDER=demo
TRAIN_PROVIDER=demo
HOTEL_PROVIDER=demo
CAB_PROVIDER=tripifi
ROUTING_PROVIDER=osrm
GEOCODING_PROVIDER=nominatim
WEATHER_PROVIDER=demo
AVIATION_API_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1
# Free tier is ~100 req/month, personal-use only: the flight-status adapter
# stays DISABLED unless a paid key is explicitly opted in.
AVIATIONSTACK_PAID_KEY=false
AVIATIONSTACK_MONTHLY_QUOTA=100
GRAPHHOPPER_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
# Public OSRM demo server is NOT for production — self-host OSRM
# (https://switch2osm.org/serving-tiles/manually-building-a-tile-server/)
# and point OSRM_BASE_URL at it for production traffic.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api
# Open-Meteo free endpoint is NON-COMMERCIAL only. Setting OPEN_METEO_API_KEY
# switches to the commercial customer API (customer-api.open-meteo.com).
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# Reliability: external timeouts, circuit breaker, quota guard.
EXTERNAL_TIMEOUT_SECONDS=8
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_OPEN_SECONDS=60
QUOTA_STOP_PCT=90

EMAIL_PROVIDER=none
EMAIL_API_KEY=
ADMIN_EMAIL=

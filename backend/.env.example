# Tripifi CGR backend — copy to .env and fill in. Never commit real secrets.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://tripifi:tripifi@localhost:5432/tripifi
SECRET_KEY=change-me-in-every-environment
JWT_SECRET=change-me-in-every-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=tripifi-demo-planner

FLIGHT_API_KEY=
HOTEL_API_KEY=
MAPS_API_KEY=
PAYMENT_API_KEY=
PAYMENT_PROVIDER=demo
PAYMENT_WEBHOOK_SECRET=

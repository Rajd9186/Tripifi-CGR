# Tripifi CGR — frontend environment (copy to .env.local; never commit secrets)

# Backend API base (optional — UI falls back to demo data when unset)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Unsplash is SERVER-ONLY. This variable must NOT be prefixed with NEXT_PUBLIC_.
# The browser never sees it — all requests go through /api/media.
# Key from https://unsplash.com/developers (free tier: 50 req/hour).
# UNSPLASH_ACCESS_KEY=
